      "BoW (spaCy):\n",
      "Counter({'alice': 2, 'apples': 2, 'likes': 1, 'eats': 1})\n"
     ]
    }
   ],
   "source": [
    "import spacy\n",
    "from collections import Counter\n",
    "\n",
    "nlp = spacy.load(\"en_core_web_sm\")\n",
    "doc = nlp(\"Alice likes apples. Alice eats apples.\")\n",
    "\n",
    "bow_spacy = Counter([token.text.lower() for token in doc if not token.is_punct])\n",
    "\n",
    "print(\"BoW (spaCy):\")\n",
    "print(bow_spacy)\n"
   ]
  },
