     "output_type": "stream",
     "text": [
      "Before: The food is very good and the service is nice.\n",
      "After: ['food', 'good', 'service', 'nice', '.']\n"
     ]
    }
   ],
   "source": [
    "import spacy\n",
    "\n",
    "# load model\n",
    "nlp = spacy.load(\"en_core_web_sm\")\n",
    "\n",
    "# sample text\n",
    "text = \"The food is very good and the service is nice.\"\n",
    "\n",
    "doc = nlp(text)\n",
    "\n",
    "# remove stop words\n",
    "filtered = [token.text for token in doc if not token.is_stop]\n",
    "\n",
    "print(\"Before:\", text)\n",
    "print(\"After:\", filtered)\n"
   ]
  },
